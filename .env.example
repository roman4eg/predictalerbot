TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
PREDICT_API_KEY=your_predict_fun_api_key_here
# Polling interval in seconds (how often to check the orderbook)
POLL_INTERVAL=10
# Polling interval for wallet positions (seconds)
WALLET_POLL_INTERVAL=30

# --- Farming bot (predict_bot / web) ---
WALLET_PRIVATE_KEY=your_private_key_here
# Optional: Predict smart-wallet deposit address (leave empty if using EOA directly)
PREDICT_ACCOUNT=
# Optional: HTTP proxy in format ip:port:user:pass or full URL
PROXY=
# Optional: comma-separated Telegram user IDs allowed to use the bot
# Get your ID from @userinfobot. If empty — bot is open to everyone.
ALLOWED_USERS=
